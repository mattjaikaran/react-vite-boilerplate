{
  "name": "react-vite-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "Modern React Vite boilerplate with TypeScript, TanStack Router, and comprehensive tooling",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b",
    "lint": "oxlint .",
    "lint:strict": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "setup": "bun install && bun run setup:shadcn",
    "setup:shadcn": "bunx shadcn@latest init -y",
    "docker:build": "docker build -t react-vite-boilerplate .",
    "docker:run": "docker run -p 3000:3000 react-vite-boilerplate",
    "feature:add": "./scripts/add-feature.sh",
    "feature:remove": "./scripts/remove-feature.sh",
    "feature:ssr": "./scripts/setup-ssr.sh",
    "feature:rsc": "./scripts/setup-rsc.sh",
    "doctor": "react-doctor . --yes --no-telemetry --no-supply-chain --blocking error",
    "check-conventions": "bun run scripts/check_conventions.ts",
    "check-dependencies": "bun run scripts/check_dependencies.ts",
    "gauntlet": "bun run format:check && bun run lint:strict && bun run type-check && bun run test && bun run check-conventions && bun run check-dependencies && bun run doctor",
    "gauntlet:quick": "bun run lint:strict && bun run type-check && bun run check-conventions && bun run check-dependencies"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-select": "2.1.1",
    "@radix-ui/react-slot": "1.1.0",
    "@tanstack/react-query": "5.56.2",
    "@tanstack/react-query-devtools": "5.56.2",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-table": "8.20.5",
    "axios": "1.7.7",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.441.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.53.0",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.167.34",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "24.7.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "2.1.1",
    "@vitest/ui": "2.1.1",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "postcss": "8.4.47",
    "react-doctor": "0.9.14",
    "tailwindcss": "3.4.12",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vitest": "2.1.1"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": "^20.19.0 || >=22.13.0"
  }
}
