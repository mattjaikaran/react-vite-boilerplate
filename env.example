# Application Mode
VITE_MODE=standalone
# Options: standalone, django-spa

# API origin only; generated paths already include /api.
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=10000

# Authentication uses HttpOnly cookies, never browser-stored tokens.
VITE_ENABLE_MAGIC_LINK=true

# Features
VITE_ENABLE_TODOS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_DEVTOOLS=true

# Django Integration (only when VITE_MODE=django-spa)
VITE_DJANGO_CSRF_COOKIE_NAME=csrftoken
VITE_DJANGO_STATIC_URL=/static/
VITE_DJANGO_MEDIA_URL=/media/
VITE_DJANGO_API_PREFIX=/api

# Environment
VITE_APP_ENV=development
VITE_APP_NAME=React Vite Boilerplate
VITE_APP_VERSION=1.0.0
VITE_DEBUG=false

# External Services (if needed)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id
# VITE_SENTRY_DSN=your_sentry_dsn
