# ===========================================
# Monorepo Environment Configuration
# ===========================================
# Copy this file to .env when using with Django backend
# cp env.monorepo.example .env

# Application Mode
# Set to 'django-spa' when running with Django backend
VITE_MODE=django-spa

# ===========================================
# API Configuration
# ===========================================
# API origin only; generated paths include /api.
VITE_API_BASE_URL=http://localhost:8000
# For same-origin proxy/Django deployments, leave VITE_API_BASE_URL empty.

VITE_API_TIMEOUT=10000

# ===========================================
# Authentication uses HttpOnly cookies with CSRF protection.
VITE_ENABLE_MAGIC_LINK=true

# ===========================================
# Django Integration
# ===========================================
# CSRF token cookie name (default Django setting)
VITE_DJANGO_CSRF_COOKIE_NAME=csrftoken

# Static and media URL prefixes (match your Django settings)
VITE_DJANGO_STATIC_URL=/static/
VITE_DJANGO_MEDIA_URL=/media/

# API prefix (match your Django Ninja router prefix)
VITE_DJANGO_API_PREFIX=/api

# ===========================================
# Features
# ===========================================
VITE_ENABLE_TODOS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_DEVTOOLS=true


# ===========================================
# Environment
# ===========================================
VITE_APP_ENV=development
VITE_APP_NAME=Django + React App
VITE_APP_VERSION=1.0.0
VITE_DEBUG=true

# ===========================================
# Production Overrides
# ===========================================
# Uncomment and modify for production deployment:
# VITE_MODE=django-spa
# VITE_API_BASE_URL=
# VITE_APP_ENV=production
# VITE_DEBUG=false
# VITE_ENABLE_DEVTOOLS=false
